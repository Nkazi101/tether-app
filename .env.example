# Public browser settings: included in the built client.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_KEY
VITE_SUPABASE_GOOGLE_ENABLED=false

# Server-only settings. Never prefix these keys with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Generate a long random secret. Keep it stable across API replicas.
SESSION_HASH_SECRET=YOUR_LONG_RANDOM_SESSION_HASH_SECRET

# API and deployment. Development defaults to localhost:3000.
PORT=3000
BIND_HOST=0.0.0.0
# Set the exact production origin, with no trailing slash.
# APP_ORIGIN=https://your-tether-domain.example
# Trust only the actual number of reverse proxies in your deployment.
TRUST_PROXY_HOPS=0

# Optional model extraction. Without a key, conservative evidence rules work.
ANALYSIS_MODEL_ENABLED=true
MUSE_API_KEY=
MUSE_API_BASE_URL=https://api.meta.ai/v1
MUSE_CLASSIFICATION_MODEL=muse-spark-1.3
MUSE_MAX_MODEL_CALLS_PER_DAY=120
MODEL_DAILY_RESERVED_TOKEN_LIMIT=6000000
MODEL_BACKGROUND_DAILY_CALL_LIMIT=60
HISTORICAL_SEARCH_ENABLED=true
MUSE_RESEARCH_MODEL=muse-spark-1.3

# Durable daily request and concurrency allowances. Guest/user quotas supplement
# shared IP and global limits. User requests have priority over background jobs.
ANALYSIS_GUEST_DAILY_LIMIT=12
ANALYSIS_USER_DAILY_LIMIT=40
ANALYSIS_IP_DAILY_LIMIT=100
ANALYSIS_GLOBAL_DAILY_LIMIT=1000

# Optional development tooling.
# DISABLE_HMR=true
# VITE_HMR_PORT=24678
# TETHER_IMPORT_ONLY=true

# Legacy offline research scripts (excluded from supported comparison evidence).
GDELT_EPISODE_DATASET=gdelt-1.0-reduced-sample-1000
GDELT_IMPORT_BATCH_SIZE=1000
WIKIMEDIA_USER_AGENT=Tether/1.0 (historical research; replace-with-contact)

# Detailed comparison writing and source verification use the stronger model.
# Source extraction/discovery retain MUSE_RESEARCH_MODEL. All stages stay budgeted.
MUSE_NARRATIVE_MODEL=muse-wonder-1.0
MUSE_VERIFICATION_MODEL=muse-wonder-1.0
