{
  "name": "tether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node build/server.js",
    "build": "vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/seed-supabase.ts",
    "gdelt:census": "tsx scripts/import-gdelt.ts --mode census",
    "gdelt:import": "tsx scripts/import-gdelt.ts --mode import",
    "gdelt:cluster": "tsx scripts/cluster-gdelt.ts",
    "gdelt:enrich": "tsx scripts/enrich-gdelt-episodes.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "worker": "node build/server/worker.js",
    "worker:dev": "tsx server/worker.ts",
    "scheduler": "node build/server/scheduler.js",
    "enqueue:ingest": "node build/server/scheduler.js --once",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "supabase db query --linked --file supabase/tests/living_comparisons.sql",
    "seed:walkthrough": "tsx scripts/seed-walkthrough.ts",
    "check": "npm run lint && npm test && npm run build",
    "archive:case": "tsx scripts/publish-case.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.4",
    "undici": "^8.12.3",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "overrides": {
    "qs": "^6.16.1",
    "esbuild": "^0.28.2"
  }
}
